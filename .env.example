# ── Mode data ─────────────────────────────────────────────
# Produksi wajib memakai Google Sheets: isi dua nilai di bawah (lihat
# apps-script/Code.gs). Di Vercel, nilai kosong membuat aplikasi berhenti
# dengan pesan konfigurasi — tidak ada penyimpanan lokal atau data demo.
GOOGLE_SHEETS_URL=
GOOGLE_SHEETS_KEY=
# Khusus pengembangan lokal: isi "false" agar mulai dari data kosong.
# SEED_DEMO=false
# ID spreadsheet hanya dipakai untuk tautan di panel developer (bukan rahasia).
GOOGLE_SPREADSHEET_ID=1bBqUXFwxlqM3bSh4RxwkzW97AOO7fIyWXfo7-i6Djos

# ── Keamanan ──────────────────────────────────────────────
# Isi dengan kata sandi sendiri; jangan commit nilai aslinya.
AUTH_SECRET=ganti-dengan-kalimat-acak-panjang
ADMIN_PASSWORD=ganti-password-admin
# Kata sandi bersama tim kurir; kurir masuk tanpa nomor HP.
COURIER_PASSWORD=ganti-password-kurir
DEVELOPER_PASSWORD=ganti-password-developer

# ── Notifikasi WhatsApp (opsional, otomatis saat pesanan masuk) ──
# Nomor admin; bila kosong memakai pengaturan toko / 628980440095.
WHATSAPP_ADMIN=628980440095
# Pilih salah satu penyedia:
# 1) Fonnte (mudah, populer di Indonesia) — isi token device.
# FONNTE_TOKEN=
# 2) WhatsApp Cloud API resmi Meta.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# ── Publik (opsional) ─────────────────────────────────────
# URL produksi untuk metadata, OG, dan tautan notifikasi WhatsApp.
NEXT_PUBLIC_SITE_URL=

# ── Upload gambar (opsional, otomatis aktif di Vercel) ────
# BLOB_READ_WRITE_TOKEN=
